{
  "name": "sanmeigaku",
  "version": "0.0.0-development",
  "description": "日本の算命学に特化した命式計算ライブラリ",
  "keywords": [
    "npm-package",
    "sanmeigaku",
    "typescript",
    "命式",
    "算命学"
  ],
  "homepage": "https://github.com/chonai-flora/sanmeigaku#readme",
  "bugs": {
    "url": "https://github.com/chonai-flora/sanmeigaku/issues"
  },
  "license": "MIT",
  "author": "chonai-flora",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chonai-flora/sanmeigaku.git"
  },
  "files": [
    "dist",
    "src/**/*.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "lint": "oxfmt --check && oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxfmt && oxlint --type-aware --fix --deny-warnings --report-unused-disable-directives",
    "generate:sekki-boundaries": "bun scripts/generate-sekki-boundaries.ts",
    "check": "bun run lint && bun run build && bun test",
    "prepack": "bun run check"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "astronomia": "4.2.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "packageManager": "bun@1.3.13"
}
